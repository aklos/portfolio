# Substack (scripts/syndicate_substack.py)
# There is no official publishing API, so this uses a signed-in session.
# Get COOKIES_STRING: sign in to Substack, open devtools > Network, refresh,
# pick any request, and copy the full `cookie` request header value.
PUBLICATION_URL=https://aklos.substack.com
COOKIES_STRING=
# Alternative to COOKIES_STRING — a cookies JSON file exported via api.export_cookies()
COOKIES_PATH=

# LinkedIn (scripts/syndicate_linkedin.py)
# Create an app at https://www.linkedin.com/developers/apps and add the
# "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn" products.
# Both are self-serve — no approval review needed.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Produced by: python scripts/linkedin_auth.py  (expires after ~60 days)
LINKEDIN_ACCESS_TOKEN=
# Optional — skips the /v2/userinfo lookup on every run
LINKEDIN_AUTHOR_URN=

# Unsplash (scripts/cover_picker.py)
# Create an app at https://unsplash.com/oauth/applications — the Access Key is
# all that's needed. Demo apps get 50 searches/hour, which is plenty.
UNSPLASH_ACCESS_KEY=
